{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(./exceljs.min.js)",
      "Bash(cat exceljs.min.js*)",
      "Bash(cat ./exceljs.min.js*)"
    ]
  },
  "env": {
    "MAX_MCP_OUTPUT_TOKENS": "10000",
    "BASH_MAX_OUTPUT_LENGTH": "20000"
  }
}
