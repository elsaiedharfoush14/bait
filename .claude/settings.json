{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(./exceljs.min.js)",
      "Bash(cat exceljs.min.js*)",
      "Bash(cat ./exceljs.min.js*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "command -v python3 >/dev/null 2>&1 && exec python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/read_guard.py\" || exec python \"$CLAUDE_PROJECT_DIR/.claude/hooks/read_guard.py\"",
            "timeout": 15
          }
        ]
      }
    ]
  },
  "env": {
    "MAX_MCP_OUTPUT_TOKENS": "10000",
    "BASH_MAX_OUTPUT_LENGTH": "20000"
  }
}
